{
  "name": "@ao/workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/erp",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @ao/erp dev",
    "dev:erp": "bun run --filter @ao/erp dev",
    "build": "bun run --filter @ao/erp build",
    "build:erp": "bun run --filter @ao/erp build",
    "typecheck:erp": "bun run --filter @ao/erp typecheck",
    "lint:erp": "bun run --filter @ao/erp lint",
    "test": "bun run --filter @ao/erp test",
    "test:erp": "bun run --filter @ao/erp test",
    "preview:erp": "bun run --filter @ao/erp preview"
  },
  "overrides": {
    "rolldown": "1.2.1"
  }
}
