    "preview:erp": "bun run --filter @ao/erp preview",
    "dev:saas": "bun run --filter @ao/saas dev",
    "build:saas": "bun run --filter @ao/saas build",
    "typecheck:saas": "bun run --filter @ao/saas typecheck",
    "lint:saas": "bun run --filter @ao/saas lint",
    "test:saas": "bun run --filter @ao/saas test",
    "preview:saas": "bun run --filter @ao/saas preview",
    "dev:diocesano": "bun run --filter @ao/diocesano dev",
    "build:diocesano": "bun run --filter @ao/diocesano build",
    "typecheck:diocesano": "bun run --filter @ao/diocesano typecheck",
